{
  "$schema": "https://opencode.ai/config.json",
  "plugins": ["opencode-architect@latest"],
  "permissions": [
    { "action": "tool.use", "resource": "MCP_DOCKER_duckduckgo*", "effect": "allow" },
    { "action": "tool.use", "resource": "MCP_DOCKER_exa*", "effect": "allow" },
    { "action": "tool.use", "resource": "deepWiki*", "effect": "allow" },
    { "action": "tool.use", "resource": "sequential-thinking_*", "effect": "allow" },
    { "action": "tool.use", "resource": "google_search", "effect": "deny" }
  ]
}